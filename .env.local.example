# Local Development Environment Configuration
# This file is configured for use with Docker Compose

# ==== Database Configuration ====
# For Docker Compose with PostgreSQL container
DATABASE_URL="postgresql://postgres:mysecretpassword@papermark-db:5432/paper?schema=public"
POSTGRES_PRISMA_URL="postgresql://postgres:mysecretpassword@papermark-db:5432/paper?schema=public"
POSTGRES_PRISMA_URL_NON_POOLING="postgresql://postgres:mysecretpassword@papermark-db:5432/paper?schema=public"

# ==== Authentication Secrets ====
# Generate these with: openssl rand -base64 32
NEXTAUTH_SECRET=local-dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# ==== Application URLs ====
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_APP_BASE_HOST=localhost

# ==== Document Security ====
# Generate with: openssl rand -base64 32
NEXT_PRIVATE_DOCUMENT_PASSWORD_KEY=local-dev-document-secret-change-in-production

# ==== File Storage Configuration ====
# Using MinIO (S3-compatible) for local development
NEXT_PUBLIC_UPLOAD_TRANSPORT="s3"
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_HOST="localhost:9000"
NEXT_PRIVATE_UPLOAD_ENDPOINT="http://localhost:9000"
NEXT_PRIVATE_UPLOAD_REGION="us-east-1"
NEXT_PRIVATE_UPLOAD_BUCKET="papermark"
NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID="minioadmin"
NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY="minioadmin"

# Advanced upload bucket for tus.io uploads
NEXT_PRIVATE_ADVANCED_UPLOAD_BUCKET="papermark-advanced"

# ==== Redis Configuration ====
# For rate limiting and tus locker (using local Redis container)
UPSTASH_REDIS_REST_LOCKER_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_LOCKER_TOKEN=""

# ==== Local Development Features ====
# Enable datarooms for all plans in local development
ENABLE_DATAROOMS_FOR_ALL=true

# ==== Verification ====
NEXT_PRIVATE_VERIFICATION_SECRET=local-verification-secret

# ==== Webhooks (for local testing) ====
NEXT_PUBLIC_WEBHOOK_BASE_URL=http://localhost:3000
NEXT_PUBLIC_WEBHOOK_BASE_HOST=localhost

# ==== Optional Services (Leave blank for minimal setup) ====
# Add these if you want to test specific features:

# Email service (Resend) - for email functionality
# RESEND_API_KEY=

# Analytics (Tinybird) - for analytics features
# TINYBIRD_TOKEN=

# Google OAuth - for Google authentication
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Vercel integration - for custom domains
# PROJECT_ID_VERCEL=
# TEAM_ID_VERCEL=
# AUTH_BEARER_TOKEN=

# Background jobs (QStash) - for queue processing
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=

# Passkey authentication (Hanko)
# HANKO_API_KEY=
# NEXT_PUBLIC_HANKO_TENANT_ID=

# Trigger.dev - for background workflows
# TRIGGER_SECRET_KEY=
# TRIGGER_API_URL=https://api.trigger.dev

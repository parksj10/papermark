# Local Development Environment Variables
# Copy this file to .env.local for local development with Docker and MinIO
# This configuration bypasses Redis requirements and uses in-memory locking

# ===== DATABASE =====
DATABASE_URL="postgresql://postgres:mysecretpassword@papermark-db:5432/paper?schema=public"
POSTGRES_PRISMA_URL="postgresql://postgres:mysecretpassword@papermark-db:5432/paper?schema=public"
POSTGRES_PRISMA_URL_NON_POOLING="postgresql://postgres:mysecretpassword@papermark-db:5432/paper?schema=public"

# ===== AUTHENTICATION =====
NEXTAUTH_SECRET=my-superstrong-secret
NEXTAUTH_URL=http://localhost:3000

# ===== APPLICATION URLS =====
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_APP_BASE_HOST=localhost
NEXT_PUBLIC_WEBHOOK_BASE_HOST=localhost

# ===== FILE STORAGE - MINIO =====
NEXT_PUBLIC_UPLOAD_TRANSPORT="s3"
NEXT_PRIVATE_UPLOAD_ENDPOINT="http://minio:9000"
NEXT_PRIVATE_UPLOAD_REGION="us-east-1"
NEXT_PRIVATE_UPLOAD_BUCKET="papermark-uploads"
NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID="papermark"
NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY="papermark123"
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_HOST="localhost:9000"

# ===== SECURITY =====
NEXT_PRIVATE_DOCUMENT_PASSWORD_KEY=my-superstrong-document-secret
NEXT_PRIVATE_VERIFICATION_SECRET=my-verification-secret

# ===== HANKO AUTHENTICATION =====
HANKO_API_KEY=placeholder-hanko-api-key
NEXT_PUBLIC_HANKO_TENANT_ID=placeholder-hanko-tenant-id

# ===== TRIGGER DEV CONFIGURATION =====
TRIGGER_SECRET_KEY=""
TRIGGER_API_URL=https://api.trigger.dev

# ===== REDIS CONFIGURATION (NOT USED IN LOCAL DEV) =====
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
UPSTASH_REDIS_REST_LOCKER_URL=""
UPSTASH_REDIS_REST_LOCKER_TOKEN=""